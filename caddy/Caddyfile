{
	auto_https off
	admin off
	on_demand_tls {
		ask http://admin-ui:8080/tls/allow
	}
}

:443 {
	tls internal {
		on_demand
	}

	handle /healthz {
		respond "ok" 200
	}

	handle /umds-patch-store/* {
		root * /depot
		header Accept-Ranges "bytes"
		file_server browse
	}

	handle /admin {
		redir /admin/ 308
	}

	handle_path /admin/* {
		reverse_proxy admin-ui:8080
	}

	handle {
		forward_auth admin-ui:8080 {
			uri /auth/check
		}
		root * /depot
		header Accept-Ranges "bytes"
		file_server browse
	}
}
