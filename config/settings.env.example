# Reference only. The bootstrap container creates these defaults in the
# vcf-services-config volume, and the admin console is the supported editor.
AUTH_USERNAME=vcf
BACKUP_ENABLED=false
CEIP=DISABLE
CRON_SCHEDULE=0 3 * * 0
DEPOT_ENDPOINT=dl.broadcom.com
ESX_MODE=download
LOG_RETENTION=20
SETUP_COMPLETE=false
SFTP_UID_GID=1003:1003
SKU=VCF
STORAGE_CONFIRMED=false
SYNC_TARGETS=esx install upgrade patches
TOKEN_URL=https://eapi.broadcom.com/vcf/generateToken
TZ=UTC
VCF_VERSION=9.1.0
VKR_MATCH=
VKR_OS=
