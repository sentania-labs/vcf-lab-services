# Non-secret configuration written by install.sh.
PRODUCT_FQDN=vcf-services.example.com
TZ=UTC
VCF_VERSION=9.1.0
SKU=VCF
SYNC_TARGETS=esx install upgrade patches
CRON_SCHEDULE=0 3 * * 0
CEIP=DISABLE
ESX_MODE=download
LOG_RETENTION=20
VKR_MATCH=
VKR_OS=
DEPOT_ENDPOINT=dl.broadcom.com
TOKEN_URL=https://eapi.broadcom.com/vcf/generateToken
AUTH_USERNAME=vcf
TLS_MODE=self-signed
STORAGE_MODE=local
DEPOT_VOLUME_NAME=vcf-services-depot-store-example
DEPOT_LOCAL_PATH=./data/depot
NFS_SERVER=
NFS_EXPORT=
NFS_OPTIONS=nfsvers=4,rw,hard,timeo=600,retrans=2
HTTPS_PORT=443
BACKUP_ENABLED=true
SFTP_PORT=2222
SFTP_UID_GID=1003:1003
BACKUP_VOLUME_NAME=vcf-services-backup-store-example
BACKUP_LOCAL_PATH=./data/depot/backup
BACKUP_NFS_EXPORT=
VCFDT_VERSION=unknown
