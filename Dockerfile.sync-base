FROM debian:bookworm-slim

ARG VCF_SERVICES_VERSION=dev
ARG VCF_SERVICES_REVISION=unknown
ARG VCF_SERVICES_SOURCE=unknown

LABEL org.opencontainers.image.title="VCF Services Sync Base" \
      org.opencontainers.image.description="License-safe sync runtime without the VCF Download Tool" \
      org.opencontainers.image.version="$VCF_SERVICES_VERSION" \
      org.opencontainers.image.revision="$VCF_SERVICES_REVISION" \
      org.opencontainers.image.source="$VCF_SERVICES_SOURCE" \
      org.opencontainers.image.licenses="MIT"

ENV DEBIAN_FRONTEND=noninteractive \
    VCF_SERVICES_VERSION="$VCF_SERVICES_VERSION"

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl jq redis-tools tzdata util-linux \
 && rm -rf /var/lib/apt/lists/*

COPY sync/sync.sh /usr/local/bin/sync.sh
COPY sync/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY sync/targets/ /usr/local/lib/vcf-services/targets/
RUN chmod 0755 /usr/local/bin/sync.sh /usr/local/bin/entrypoint.sh \
    /usr/local/lib/vcf-services/targets/*.sh

WORKDIR /opt/vcfdt
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
